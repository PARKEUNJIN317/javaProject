<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="com.spring_mvc.mybatisEx.dao.IBookDAO">
	<resultMap type="com.spring_mvc.mybatisEx.VO.BookVO" id="bookResult">
		<result property="bookNo" column="bookNo"/>
		<result property="bookName" column="bookName"/>
		<result property="bookAuthor" column="bookAuthor"/>
		<result property="bookPrice" column="bookPrice"/>
		<result property="bookDate" column="bookDate"/>
		<result property="bookStock" column="bookStock"/>
		<result property="pubNo" column="pubNo"/>
	</resultMap>


	 <select id="listAllBook" resultMap="com.spring_mvc.mybatisEx.vo.BookVO">
		SELECT * FROM book ORDER BY bookNo
	</select>
	
	<insert id="insertProduct" parameterType="com.spring_mvc.mybatisEx.vo.BookVO">
		INSERT INTO book(bookNo, bookName, bookAuthor, bookPrice, bookDate, bookStock, pubNo)
		VALUES (#{bookNo}, #{bookName}, #{bookAuthor}, #{bookPrice}, #{bookDate}, #{bookStock}, #{pubNo})
	</insert>
	
	
	<select id ="detailViewBook" parameterType="string" resultType="com.spring_mvc.mybatisEx.vo.BookVO">
		SELECT * FROM book WHERE bookNo=#{bookNo}
	</select>
	
	<update id="updateBook" parameterType="com.spring_mvc.mybatisEx.vo.BookVO">
		UPDATE book SET bookName=#{bookName},bookAutor=#{bookAuthor}, bookPrice=#{bookPrice}, bookDate=#{bookDate}, bookStock=#{bookStock}, pubNo=#{pubNo}
		WHERE bookNo=#{bookNo}	
	</update>
	
	<delete id="deleteBook" parameterType="string">
		DELETE FROM book WHERE bookNo=#{bookNo}
	</delete>
	 
</mapper>